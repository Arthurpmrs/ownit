# Database
POSTGRES_DB = "ownit_dev"
POSTGRES_USER = "ownit_admin"
POSTGRES_PASSWORD = "ownit_admin"
DATABASE_URL = "postgresql+psycopg://ownit_admin:ownit_admin@pgsql:5432/ownit_dev"

# Application
ENV="dev"
VITE_API_URL = "http://localhost:8000"

# LLM Config
LLM_API_KEY = "sk-example-key"
LLM_BASE_URL = "https://api.deepseek.com/v1"
LLM_MODEL = "deepseek-v4-flash"

# Embedding & RAG Config
EMBEDDING_API_KEY = "sk-example-key"
EMBEDDING_BASE_URL = "https://api.openai.com/v1"
EMBEDDING_MODEL = "text-embedding-3-small"
EMBEDDING_DIMENSION = 1536
RAG_TOP_K = 5
RAG_SIMILARITY_THRESHOLD = 0.5
RAG_MAX_CONTEXT_TOKENS = 3000
USER_GUIDE_PATH = "../user-guide"
